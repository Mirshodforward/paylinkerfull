# /etc/nginx/sites-available/paylinker ga nusxalang, keyin:
#   sudo ln -s /etc/nginx/sites-available/paylinker /etc/nginx/sites-enabled/
#
# BIRINCHI BOSQICH — ilova faqat `web.paylinker.uz` subdomenida turadi.
# Asosiy `paylinker.uz` keyin ulanadi (pastdagi ixtiyoriy blokni oching).
#
# Avval HTTP (80) bilan tekshirib, keyin certbot:
#   sudo certbot --nginx -d web.paylinker.uz
#
# Keyinroq asosiy domen qo'shilganda:
#   sudo certbot --nginx -d web.paylinker.uz -d paylinker.uz -d www.paylinker.uz --expand
#
# Bir serverda nechta loyiha bo'lsa: har domen alohida server_name + paylinker uchun
# alohida portlar (boshqa loyiha paylinker portini band qilmasin). Muammo: deploy/NGINX-MULTI-SITE.md
#
# Next.js va Nest API — PM2: 127.0.0.1:8000 va :8001
#
# Certbot dan keyin HTTPS (443) server bloklarida ham — birinchi domen uchun —
# shu `location /api/payments/click/` ni takrorlang (yoki faqat Next rewrites yetadi).

upstream paylinker_next {
    # .env da PAYLINKER_WEB_PORT bilan mos (odat 8000)
    server 127.0.0.1:8000;
    keepalive 64;
}

upstream paylinker_api {
    # .env da PAYLINKER_API_PORT bilan mos
    server 127.0.0.1:8001;
    keepalive 64;
}

# Takrorlanadigan proxy sozlamalari
# (nginx `include` talab qilmasin uchun har blokda yozilgan)

# ── ASOSIY: web.paylinker.uz ────────────────────────────────────────────────
# HTTP → HTTPS (certbot bundan keyin SSL bloklarini qo'shadi)
server {
    listen 80;
    listen [::]:80;
    server_name web.paylinker.uz;

    # 413 Request Entity Too Large: nginx default ~1m. `location /` (Next) va barcha proxy uchun.
    client_max_body_size 25m;

    # Nest API — shu domen orqali (alohida api subdomen shart emas). 443 blokda ham xuddi shu.
    location /auth {
        proxy_pass http://paylinker_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }
    location /vizitka {
        proxy_pass http://paylinker_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }
    location /landings {
        proxy_pass http://paylinker_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }
    location /telegram {
        proxy_pass http://paylinker_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }
    location /payments {
        proxy_pass http://paylinker_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }
    location = /health {
        proxy_pass http://paylinker_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # CLICK Prepare/Complete
    location /api/payments/click/ {
        proxy_pass http://paylinker_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    # Admin API
    location /api/admin/ {
        proxy_pass http://paylinker_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 5m;
    }

    # Statik logo/rasm (Nest uploads/)
    location /uploads/ {
        proxy_pass http://paylinker_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 5m;
    }

    location / {
        proxy_pass http://paylinker_next;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}

# ── IXTIYORIY (2-bosqich): paylinker.uz + www → web.paylinker.uz ────────────
# UI da havolalar `paylinker.uz/{slug}` ko'rinishida chiqadi. Asosiy domen shu
# serverga qaratilgach quyidagi blokni oching — havolalar ishlay boshlaydi.
#
# Variant A — redirect (oddiy, SEO uchun toza):
#
# server {
#     listen 80;
#     listen [::]:80;
#     server_name paylinker.uz www.paylinker.uz;
#     return 301 https://web.paylinker.uz$request_uri;
# }
#
# Variant B — o'sha ilovani asosiy domenda ham ko'rsatish:
# yuqoridagi `web.paylinker.uz` blokidan nusxa olib, faqat
# `server_name paylinker.uz www.paylinker.uz;` deb o'zgartiring va
# `.env` da NEXT_PUBLIC_SITE_DOMAIN=paylinker.uz qo'ying (keyin qayta build).

# ── IXTIYORIY: api.paylinker.uz (alohida API subdomen) ──────────────────────
# server {
#     listen 80;
#     listen [::]:80;
#     server_name api.paylinker.uz;
#
#     client_max_body_size 25m;
#
#     location / {
#         proxy_pass http://paylinker_api;
#         proxy_http_version 1.1;
#         proxy_set_header Host $host;
#         proxy_set_header X-Real-IP $remote_addr;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         client_max_body_size 25m;
#     }
# }
