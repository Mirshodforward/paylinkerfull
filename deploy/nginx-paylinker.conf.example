# ─────────────────────────────────────────────────────────────────────────────
#  Nginx — Paylinker WEB (sayt konstruktori): web.paylinker.uz
#
#  Bu fayl serverda ishlayotgan konfiguratsiyaning aynan nusxasi:
#    /etc/nginx/sites-available/paylinker-web
#
#  O'rnatish:
#    sudo cp deploy/nginx-paylinker.conf.example /etc/nginx/sites-available/paylinker-web
#    sudo ln -sfn /etc/nginx/sites-available/paylinker-web /etc/nginx/sites-enabled/
#    sudo mkdir -p /var/www/certbot
#    sudo nginx -t && sudo systemctl reload nginx
#    sudo certbot --nginx -d web.paylinker.uz      # DNS A yozuvi tayyor bo'lgach
#
#  Certbot bu faylga 443 bloki va HTTP->HTTPS redirectni O'ZI qo'shadi —
#  shundan keyin serverdagi nusxa bu fayldan farq qiladi (bu normal).
#
#  DIQQAT: bir serverda `paylinker` nomli boshqa sayt ham bo'lishi mumkin
#  (api.paylinker.uz — Click to'lov shlyuzi, :4000). Bu ALOHIDA loyiha:
#  Next :8000 + Nest :8001. Portlarni ulashmang. deploy/NGINX-MULTI-SITE.md
# ─────────────────────────────────────────────────────────────────────────────

upstream paylinkerweb_next {
    # .env da PAYLINKER_WEB_PORT bilan mos (odat 8000)
    server 127.0.0.1:8000;
    keepalive 64;
}

upstream paylinkerweb_api {
    # .env da PAYLINKER_API_PORT bilan mos (odat 8001)
    server 127.0.0.1:8001;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name web.paylinker.uz;

    # Certbot webroot (--webroot bilan olinsa)
    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    # 413 Request Entity Too Large: nginx default ~1m.
    # Landing kontenti hero/about rasmlarini `data:` URL sifatida yuboradi.
    client_max_body_size 25m;

    # CVE-2025-66478 to'sig'i.
    # `Next-Action` header'li so'rov = React Server Components chaqiruvi.
    # Bu ilova Server Action ISHLATMAYDI ("use server" hech qayerda yo'q),
    # shuning uchun bunday qonuniy so'rov bo'lmaydi — bemalol rad etamiz.
    if ($http_next_action) { return 403; }

    # ── Nest API — shu domen orqali (alohida api subdomen shart emas) ────────
    location /auth {
        proxy_pass http://paylinkerweb_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /vizitka {
        proxy_pass http://paylinkerweb_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /landings {
        proxy_pass http://paylinkerweb_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /telegram {
        proxy_pass http://paylinkerweb_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /payments {
        proxy_pass http://paylinkerweb_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /health {
        proxy_pass http://paylinkerweb_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # CLICK Prepare/Complete
    location /api/payments/click/ {
        proxy_pass http://paylinkerweb_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Admin API
    location /api/admin/ {
        proxy_pass http://paylinkerweb_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 5m;
    }

    # Yuklangan vizitka logolari (Nest uploads/)
    location /uploads/ {
        proxy_pass http://paylinkerweb_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 5m;
    }

    # ── Next.js ──────────────────────────────────────────────────────────────
    location / {
        proxy_pass http://paylinkerweb_next;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 86400;
    }
}

# ── IXTIYORIY (2-bosqich): asosiy paylinker.uz ni ulash ──────────────────────
# Hozir paylinker.uz boshqa hostga (216.198.79.1) qaragan. Agar keyin shu
# serverga olib kelinsa:
#
#   Variant A — redirect (havolalar web. da qoladi):
#     server {
#         listen 80; listen [::]:80;
#         server_name paylinker.uz www.paylinker.uz;
#         return 301 https://web.paylinker.uz$request_uri;
#     }
#
#   Variant B — ilovani asosiy domenda ham ko'rsatish: yuqoridagi blokdan
#   nusxa oling, `server_name paylinker.uz www.paylinker.uz;` qiling va
#   `.env` da NEXT_PUBLIC_SITE_DOMAIN=paylinker.uz (keyin qayta build).
