# Serverdagi loyiha ildiziga `.env` nomi bilan nusxalang (masalan /opt/paylinker/.env).
# Ishlab chiqarishda NODE_ENV=production bo‘lsin.

NODE_ENV=production

# PostgreSQL (masalan, oddiy: localhost yoki alohida host)
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/paylinker_db"

# JWT — uzun va tasodifiy qiymatlar (dev qiymatlarini qayta ishlatmang)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=false
NEXT_PUBLIC_TELEGRAM_BOT=paylinkeruz_bot

# ─── Domen ─────────────────────────────────────────────────────────────────
# UI da ko'rinadigan havola domeni (paylinker.uz/{slug}):
NEXT_PUBLIC_SITE_DOMAIN=paylinker.uz

# Sayt manzili (billing matnlari, SEO)
NEXT_PUBLIC_APP_URL=https://paylinker.uz

# Eslatma: API chaqiruvlari brauzerda avtomatik bir xil domen
# (paylinker.uz/auth/...). NEXT_PUBLIC_API_URL shart emas.
# Server (RSC) — ichki Nest:
INTERNAL_API_URL=http://127.0.0.1:8001

# Nest CORS: vergul bilan bir nechta manba
FRONTEND_ORIGIN=https://paylinker.uz,https://www.paylinker.uz

# Telegram obuna tugashi xabaridagi havola (bo'lmasa FRONTEND_ORIGIN dagi birinchi domen)
PUBLIC_APP_URL=https://paylinker.uz

# NEXT_PUBLIC_* o'zgargach `npm run build` qayta bajarilishi SHART.
# ───────────────────────────────────────────────────────────────────────────

# Obuna tugashi eslatmasini o‘chirish: 0 yoki false
VIZITKA_EXPIRY_NOTIFY_ENABLED=true
LANDING_EXPIRY_NOTIFY_ENABLED=true

# Eskiz SMS (landing/vizitka obuna tugashi xabarlari)
ESKIZ_TOKEN=
# yoki ESKIZ_EMAIL= + ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Ichki portlar — PM2 paylinker.config.cjs o‘qiydi (takrorlamang: PORT/API_PORT shart emas)
PAYLINKER_WEB_PORT=8000
PAYLINKER_API_PORT=8001

# CLICK (merchant kabinetida Prepare/Complete:
#   https://paylinker.uz/api/payments/click/prepare
#   https://paylinker.uz/api/payments/click/complete )
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
